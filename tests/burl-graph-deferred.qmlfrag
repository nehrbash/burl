property var cycleState: Qt.createQmlObject('import Quickshell; import qs.components; ScreenState { modelData: Quickshell.screens[0] }', host)
function find(item, predicate) {
    if (predicate(item)) return item;
    for (const child of item.children ?? []) {
        const found = find(child, predicate);
        if (found) return found;
    }
    return null;
}
function check(ok, label) {
    if (!ok) { console.error('SEARCH-FAIL', label); Qt.quit(); }
    else console.log('SEARCH-PASS', label);
}
Timer { interval: 5500; running: true; onTriggered: host.cycleState.openWorldRoom('launcher') }
Timer {
    interval: 8200; running: true
    onTriggered: {
        const search = host.find(subject, item => typeof item.syncOpen === 'function');
        host.check(search && search.activeFocus, 'search keyboard focus');
        search.text = 'burl';
    }
}
Timer {
    interval: 10300; running: true
    onTriggered: {
        const graph = host.find(subject, item => item._renderIntervalMs !== undefined);
        const edges = host.find(graph, item => typeof item.rebuildPaths === 'function');
        host.check(graph.matchIndices.length > 0 && graph.currentNode >= 0, 'query produces a selection');
        host.check(edges.paths.some(p => p.length > 0), 'filtered edges render');
        const before = graph.currentNode;
        graph.navDirection(1, 0);
        if (graph.currentNode !== before) {
            graph.navigateBack();
            host.check(graph.currentNode === before, 'spatial navigation backtracks');
        }
    }
}

Timer {
    interval: 10700; running: true
    onTriggered: {
        const graph = host.find(subject, item => item._renderIntervalMs !== undefined);
        graph.nodes = graph.nodes.slice(0, -3);
    }
}
Timer {
    interval: 10900; running: true
    onTriggered: {
        const graph = host.find(subject, item => item._renderIntervalMs !== undefined);
        graph.rebuild();
    }
}

Timer {
    interval: 11500; running: true
    onTriggered: {
        const graph = host.find(subject, item => item.orbitCount !== undefined);
        const discs = [];
        function scan(item) {
            if (item.node !== undefined && item.index !== undefined) discs.push(item);
            for (const child of item.children ?? []) scan(child);
        }
        scan(graph);
        host.check(discs.length === graph.nodes.length && discs.every(item => item.visible), 'deferred graph attaches every node');
    }
}
