property var cycleState: Qt.createQmlObject('import Quickshell; import qs.components; ScreenState { modelData: Quickshell.screens[0] }', host)
property var paletteBridge: Qt.createQmlObject('import QtQuick; import qs.services; QtObject { readonly property var palette: Colours.current }', host)
property var testedNode: null
property var testedDisc: null
property var originalNodes: null
property int palettePhase: 0
function findApp(item) {
    if (item.node?.kind === "app" && item.children.some(child => child.radius !== undefined && child.border !== undefined)) return item;
    for (const child of item.children ?? []) {
        const found = findApp(child);
        if (found) return found;
    }
    return null;
}
Timer {
    interval: 100; repeat: true; running: true
    onTriggered: {
        if (host.palettePhase === 0) {
            const node = host.findApp(subject);
            if (!node) return;
            const disc = node.children.find(child => child.radius !== undefined && child.border !== undefined);
            if (!disc) throw new Error("Graph disc missing");
            subject.paused = true;
            host.testedNode = node;
            host.testedDisc = disc;
            host.originalNodes = subject.nodes;
            host.paletteBridge.palette.m3primary = "#123456";
            host.palettePhase = 1;
        } else if (host.palettePhase === 1) {
            if (host.testedDisc.color.toString() !== "#123456") throw new Error("Existing graph disc ignored palette change");
            if (subject.nodes !== host.originalNodes || host.findApp(subject) !== host.testedNode)
                throw new Error("Palette change rebuilt graph nodes");
            console.log("GRAPH-PALETTE-PASS");
            running = false;
        }
    }
}
