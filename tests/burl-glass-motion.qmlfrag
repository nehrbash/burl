property real initialPhase: 0
property bool reduced: Quickshell.env('BURL_NO_AMBIENT') === '1'
function check(ok, message) {
    if (!ok) { console.error('GLASS-FAIL', message); Qt.quit(); }
    else console.log('GLASS-PASS', message);
}
Timer {
    interval: 500; running: true
    onTriggered: {
        host.check(subject.moving === !host.reduced, 'glass respects motion preference');
        host.initialPhase = subject.phase;
    }
}
Timer {
    interval: 1000; running: true
    onTriggered: {
        host.check(host.reduced ? subject.phase === host.initialPhase : subject.phase > host.initialPhase, 'glass drifts only with motion enabled');
        subject.visible = false;
        host.initialPhase = subject.phase;
    }
}
Timer {
    interval: 1400; running: true
    onTriggered: {
        host.check(!subject.moving && subject.phase === host.initialPhase, 'hidden glass stops advancing');
        subject.active = false;
        subject.visible = true;
    }
}
Timer {
    interval: 1800; running: true
    onTriggered: host.check(!subject.moving && subject.phase === host.initialPhase, 'inactive glass stays stopped')
}
