#!/usr/bin/env -S guile -s
!#
(use-modules (ice-9 ftw)
             (ice-9 match)
             (ice-9 regex)
             (json)
             (srfi srfi-1)
             (srfi srfi-13)
             (srfi srfi-14))

(define (fail message)
  (throw 'search-error message))

(define (bounded-number value maximum)
  (let ((number (string->number value)))
    (unless (and (integer? number) (exact? number) (> number 0))
      (fail "Search limits must be positive integers"))
    (min number maximum)))

(define (arguments args)
  (let loop ((rest args) (root (getenv "HOME")) (queries '())
             (limit 60) (budget 250000) (timeout 3000))
    (match rest
      (() (values root (reverse (delete-duplicates queries)) limit budget timeout))
      (("--root" value . tail) (loop tail value queries limit budget timeout))
      (("--query" value . tail) (loop tail root (cons value queries) limit budget timeout))
      (("--limit" value . tail) (loop tail root queries (bounded-number value 60) budget timeout))
      (("--budget" value . tail) (loop tail root queries limit (bounded-number value 250000) timeout))
      (("--timeout-ms" value . tail) (loop tail root queries limit budget (bounded-number value 3000)))
      (_ (fail "Expected --query TEXT, --root DIR, --limit N, --budget N or --timeout-ms N")))))

(define (regex-pattern value)
  (if (not (string-prefix? "/" value))
      value
      (let loop ((i 1) (inside-class? #f) (chars '()))
        (when (>= i (string-length value))
          (fail "Unclosed regular expression delimiter"))
        (let ((char (string-ref value i)))
          (cond
           ((char=? char #\\)
            (when (>= (+ i 1) (string-length value))
              (fail "Unclosed regular expression delimiter"))
            (let ((next (string-ref value (+ i 1))))
              (loop (+ i 2) inside-class?
                    (if (char=? next #\/) (cons next chars)
                        (cons next (cons char chars))))))
           ((and (char=? char #\/) (not inside-class?))
            (unless (= (+ i 1) (string-length value))
              (fail "Unexpected text after regular expression delimiter"))
            (list->string (reverse chars)))
           (else
            (loop (+ i 1)
                  (cond ((char=? char #\[) #t)
                        ((char=? char #\]) #f)
                        (else inside-class?))
                  (cons char chars))))))))

(define (compile-query query)
  (let* ((regex? (string-prefix? "re:" query))
         (pattern (if regex? (regex-pattern (substring query 3)) query))
         (expression (and regex?
                          (catch #t
                            (lambda () (make-regexp pattern regexp/extended regexp/icase))
                            (lambda _ (fail "Invalid regular expression")))))
         (length (string-length (string-delete char-set:whitespace pattern))))
    (and (>= length 3)
         (cons query
               (if regex?
                   (lambda (path relative) (regexp-exec expression path))
                   (let ((words (string-tokenize (string-downcase pattern))))
                     (lambda (path relative)
                       (let ((lower (string-downcase relative)))
                         (every (lambda (word) (string-contains lower word)) words)))))))))

(define excluded-directories
  '("node_modules" "target" "build" "dist" "__pycache__" "vendor" "result"))

(define (search root queries limit budget timeout)
  (let* ((matchers (filter-map compile-query queries))
         (base (and root (false-if-exception (canonicalize-path root))))
         (started (get-internal-real-time))
         (deadline (+ started (* internal-time-units-per-second (/ timeout 1000))))
         (pending '()) (next-directories '()) (entries '()) (found 0) (scanned 0) (truncated #f))
    (unless (and base (eq? 'directory (stat:type (stat base))))
      (fail "Search root is not an accessible directory"))
    (define (exhausted?)
      (or (>= found limit) (>= scanned budget)
          (>= (get-internal-real-time) deadline)))
    (define (visit-path directory name)
      (unless (string-prefix? "." name)
        (let* ((path (string-append directory (if (string-suffix? "/" directory) "" "/") name))
               (info (false-if-exception (lstat path))))
          (when info
            (case (stat:type info)
              ((directory)
               (unless (member name excluded-directories)
                 (set! next-directories (cons path next-directories))))
              ((regular)
               (let* ((relative (substring path (+ (string-length base) (if (string=? base "/") 0 1))))
                      (hits (filter-map (lambda (matcher)
                                          (and ((cdr matcher) path relative) (car matcher)))
                                        matchers)))
                 (unless (null? hits)
                   (set! entries (cons `((path . ,path) (label . ,name)
                                        (queries . ,(list->vector hits))) entries))
                   (set! found (+ found 1))))))))))
    (define (visit-directory directory)
      (let ((stream (false-if-exception (opendir directory))))
        (when (and (not stream) (string=? directory base))
          (fail "Search root is not an accessible directory"))
        (when stream
          (dynamic-wind
            (lambda () #t)
            (lambda ()
              (let loop ()
                (if (exhausted?)
                    (set! truncated #t)
                    (let ((name (readdir stream)))
                      (unless (eof-object? name)
                        (set! scanned (+ scanned 1))
                        (visit-path directory name)
                        (loop))))))
            (lambda () (closedir stream))))))
    (unless (null? matchers)
      (set! pending (list base))
      (let loop ()
        (unless (and (null? pending) (null? next-directories))
          (when (null? pending)
            (set! pending (reverse next-directories))
            (set! next-directories '()))
          (if (exhausted?)
              (set! truncated #t)
              (let ((directory (car pending)))
                (set! pending (cdr pending))
                (visit-directory directory)
                (loop))))))
    `((entries . ,(list->vector (reverse entries)))
      (error . "") (truncated . ,truncated) (scanned . ,scanned))))

(define result
  (catch #t
    (lambda ()
      (call-with-values (lambda () (arguments (cdr (command-line)))) search))
    (lambda (key . args)
      `((entries . #())
        (error . ,(if (eq? key 'search-error) (car args) "File search failed"))
        (truncated . #f) (scanned . 0)))))
(scm->json result)
(newline)
