#!/bin/sh
# Screen recording lifecycle.
# Usage:
#   burl-record              # fullscreen (focused monitor), no sound
#   burl-record -s           # with sound
#   burl-record -r           # region (via slurp)
#   burl-record -p           # pause/resume current recording
#   burl-record -c           # copy resulting file path to clipboard on stop
# Flags combine: e.g. burl-record -r -s.
#
# Idempotent toggle — running again while a recording is active stops
# it. Notifications fire on start and stop; the stop notification
# carries Watch/Open/Delete actions.

set -eu

RECORDER=gpu-screen-recorder
PICTURES_DIR="${XDG_PICTURES_DIR:-$HOME/Pictures}"
SAVE_DIR="$PICTURES_DIR/Recordings"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/burl"
ACTIVE_PATH="$STATE_DIR/recording.mp4"
NOTIF_ID_FILE="$STATE_DIR/recording.notif"
CLIPBOARD_FLAG="$STATE_DIR/recording.clip"
LOG_PATH="$STATE_DIR/recording.log"
PID_PATH="$STATE_DIR/recording.pid"
STATUS_PATH="$STATE_DIR/recording.json"
ACTION=toggle
child_pid=
stopping=0
owned=0
phase=idle


REGION=
SOUND=0
PAUSE=0
CLIP=0

set_flag() {
    case "$1" in
        r) REGION="${REGION:-slurp}" ;;
        s) SOUND=1 ;;
        p) PAUSE=1 ;;
        c) CLIP=1 ;;
        *) echo "burl-record: unknown flag: -$1" >&2; exit 2 ;;
    esac
}

while [ $# -gt 0 ]; do
    case "$1" in
        # A missing value — or a following flag — means "ask slurp"; taking
        # it literally would hand gpu-screen-recorder a bogus capture target.
        --region)
            case "${2:-}" in
                '' | -*) REGION=slurp ;;
                *) REGION=$2; shift ;;
            esac
            ;;
        --run) ACTION=run ;;
        --start) ACTION=start ;;
        --stop) ACTION=stop ;;
        --status) ACTION=status ;;
        --sound) SOUND=1 ;;
        --pause) PAUSE=1 ;;
        --clipboard) CLIP=1 ;;
        -*)
            # Combined short flags: -sr / -sc / etc.
            i=2
            while [ "$i" -le "${#1}" ]; do
                ch=$(printf '%s' "$1" | cut -c "$i")
                set_flag "$ch"
                i=$((i + 1))
            done
            ;;
        *) echo "burl-record: unknown arg: $1" >&2; exit 2 ;;
    esac
    shift
done

owner_pid() {
    [ -f "$PID_PATH" ] || return 1
    read -r supervisor_pid <"$PID_PATH"
    case "$supervisor_pid" in '' | *[!0-9]*) return 1 ;; esac
    kill -0 "$supervisor_pid" 2>/dev/null || return 1
    [ -r "/proc/$supervisor_pid/cmdline" ] || return 1
    tr '\0' '\n' <"/proc/$supervisor_pid/cmdline" | grep -qE '(^|/)\.?burl-record(-real)?$' || return 1
    tr '\0' '\n' <"/proc/$supervisor_pid/cmdline" | grep -qx -- '--run' || return 1
    printf '%s' "$supervisor_pid"
}

publish() {
    phase=$1
    printf '{"state":"%s"}\n' "$phase" >"$STATUS_PATH.$$"
    mv "$STATUS_PATH.$$" "$STATUS_PATH"
}

release() {
    if [ "$owned" = 1 ]; then
        publish idle
        rm -f "$PID_PATH"
        owned=0
        flock -u 9
        exec 9>&-
    fi
}

cancel() {
    stopping=1
    [ "$owned" = 0 ] || publish cancelling
    [ -z "$child_pid" ] || kill -TERM "$child_pid" 2>/dev/null || true
}

pause() {
    case "$phase" in
        recording) kill -USR2 "$child_pid" 2>/dev/null && publish paused ;;
        paused) kill -USR2 "$child_pid" 2>/dev/null && publish recording ;;
    esac
}

cleanup() {
    cancel
    [ -z "$child_pid" ] || wait "$child_pid" 2>/dev/null || true
    release
}

wait_child() {
    # Signals interrupt wait before the child has flushed its output.
    while kill -0 "$child_pid" 2>/dev/null; do
        wait "$child_pid" || true
    done
    wait "$child_pid" 2>/dev/null || true
    child_pid=
}

notify() { notify-send -a burl "$1" "$2" >/dev/null 2>&1 || true; }

# gpu-screen-recorder's region format: WxH+X+Y. Offsets may be negative
# (a monitor placed left of or above 0,0), sizes may not.
region_is_valid() {
    printf '%s' "$1" | grep -qE '^[0-9]+x[0-9]+\+-?[0-9]+\+-?[0-9]+$'
}

notify_close() {
    id=$1
    gdbus call --session \
        --dest=org.freedesktop.Notifications \
        --object-path=/org/freedesktop/Notifications \
        --method=org.freedesktop.Notifications.CloseNotification "$id" >/dev/null 2>&1 || true
}

start() {
    mkdir -p "$STATE_DIR"
    if [ "$CLIP" = 1 ]; then
        : >"$CLIPBOARD_FLAG"
    else
        rm -f "$CLIPBOARD_FLAG"
    fi

    if ! monitors=$(hyprctl monitors -j 2>/dev/null) || [ -z "$monitors" ]; then
        notify "Recording failed" "Could not query Hyprland monitors"
        exit 1
    fi

    if [ -n "$REGION" ]; then
        if [ "$REGION" = "slurp" ]; then
            publish selecting
            slurp -f "%wx%h+%x+%y" >"$STATE_DIR/recording.region" &
            child_pid=$!
            [ "$stopping" = 0 ] || cancel
            wait_child
            [ "$stopping" = 0 ] || return
            REGION=$(cat "$STATE_DIR/recording.region")
            rm -f "$STATE_DIR/recording.region"

        fi
        if ! region_is_valid "$REGION"; then
            notify "Recording cancelled" "No usable region selected"
            exit 0
        fi
        # Refresh rate: max across monitors that intersect the region.
        # The -? in the coordinate patterns matters: monitors (and regions
        # on them) can sit at negative offsets, and a jq `capture` miss
        # exits 0 with empty output, silently leaving $rr blank.
        rr=$(echo "$monitors" | jq --arg r "$REGION" '
            ($r | capture("(?<w>[0-9]+)x(?<h>[0-9]+)\\+(?<x>-?[0-9]+)\\+(?<y>-?[0-9]+)")
                | map_values(tonumber)) as $reg
            | [ .[]
                | select(
                    .x < $reg.x + $reg.w and .x + .width > $reg.x and
                    .y < $reg.y + $reg.h and .y + .height > $reg.y
                  )
                | .refreshRate | round
              ] | max // 60') || rr=
        # Pass the region as the capture target itself: the separate -region
        # flag is deprecated as of gpu-screen-recorder 5.13 and warns on
        # every start.
        target=$REGION
    else
        focused=$(echo "$monitors" | jq -r \
            'first(.[] | select(.focused)) | "\(.name) \(.refreshRate | round)"') || focused=
        # Nothing reports .focused around monitor hotplug / VR handoff;
        # fall back to the first monitor rather than passing an empty -w.
        [ -n "$focused" ] || focused=$(echo "$monitors" | jq -r \
            'first(.[]) | "\(.name) \(.refreshRate | round)"') || focused=
        target=$(echo "$focused" | cut -d' ' -f1)
        rr=$(echo "$focused" | cut -d' ' -f2)
    fi

    if [ -z "$target" ]; then
        notify "Recording failed" "No monitor available to record"
        exit 1
    fi
    # Last line of defence: anything non-numeric here (including the empty
    # string, or the monitor name that `cut -f2` echoes back when jq printed
    # a single field) would leave a valueless -f in the argument list.
    case "$rr" in
        '' | *[!0-9]*) rr=60 ;;
    esac
    [ "$rr" -gt 0 ] || rr=60

    args="-w $target -f $rr"

    [ "$SOUND" = 1 ] && args="$args -a default_output"

    [ "$stopping" = 0 ] || return
    publish starting
    rm -f "$ACTIVE_PATH"
    # shellcheck disable=SC2086
    "$RECORDER" $args -o "$ACTIVE_PATH" >"$LOG_PATH" 2>&1 &
    child_pid=$!
    if [ "$stopping" = 1 ]; then
        cancel
    else
        publish recording
        notify-send -a burl -p "Recording started" "Recording..." >"$NOTIF_ID_FILE" 2>/dev/null || true
    fi
    wait_child
    if [ ! -s "$ACTIVE_PATH" ]; then
        err=$(grep -m1 'gsr error:' "$LOG_PATH" 2>/dev/null || true)
        [ -n "$err" ] || err=$(tail -n 1 "$LOG_PATH" 2>/dev/null || true)
        notify "Recording failed" "$err"
        return 1
    fi
    save
}

save() {
    publish saving
    [ -f "$ACTIVE_PATH" ] || { echo "burl-record: no recording file" >&2; exit 1; }
    mkdir -p "$SAVE_DIR"
    final="$SAVE_DIR/recording_$(date +%Y%m%d_%H-%M-%S).mp4"
    mv "$ACTIVE_PATH" "$final"

    if [ -f "$NOTIF_ID_FILE" ]; then
        notify_close "$(cat "$NOTIF_ID_FILE")"
        rm -f "$NOTIF_ID_FILE"
    fi

    if [ -f "$CLIPBOARD_FLAG" ]; then
        printf 'file://%s\n' "$final" | wl-copy --type text/uri-list
        rm -f "$CLIPBOARD_FLAG"
    fi

    release

    chosen=$(notify-send -a burl \
        --action=watch=Watch \
        --action=open=Open \
        --action=delete=Delete \
        "Recording stopped" \
        "Recording saved in $final" || true)

    case "$chosen" in
        watch) setsid -f xdg-open "$final" >/dev/null 2>&1 ;;
        open)
            dbus-send --session \
                --dest=org.freedesktop.FileManager1 \
                --type=method_call \
                /org/freedesktop/FileManager1 \
                org.freedesktop.FileManager1.ShowItems \
                "array:string:file://$final" string: 2>/dev/null \
              || setsid -f xdg-open "$SAVE_DIR" >/dev/null 2>&1
            ;;
        delete) rm -f "$final"; notify-send -a burl "Recording deleted" "$final" ;;
    esac
}

mkdir -p "$STATE_DIR"
if [ "$ACTION" = run ]; then
    exec 9>"$STATE_DIR/recording.lock"
    flock -n 9 || exit 0
    owned=1
    printf '%s\n' "$$" >"$PID_PATH"
    trap cleanup EXIT
    trap cancel TERM INT HUP
    trap pause USR2
    publish starting
    start
elif [ "$ACTION" = status ]; then
    if [ ! -f "$STATUS_PATH" ]; then
        exec 9>"$STATE_DIR/recording.lock"
        if flock -n 9; then
            [ -f "$STATUS_PATH" ] || publish idle
            flock -u 9
        fi
        exec 9>&-
    fi
    if owner_pid >/dev/null; then
        cat "$STATUS_PATH" 2>/dev/null || printf '{"state":"starting"}\n'
    else
        printf '{"state":"idle"}\n'
    fi
elif supervisor_pid=$(owner_pid); then
    if [ "$PAUSE" = 1 ]; then
        kill -USR2 "$supervisor_pid"
    elif [ "$ACTION" != start ]; then
        kill -TERM "$supervisor_pid"
    fi
elif [ "$ACTION" != stop ] && [ "$PAUSE" = 0 ]; then
    set -- --run
    [ -z "$REGION" ] || set -- "$@" --region "$REGION"
    [ "$SOUND" = 0 ] || set -- "$@" --sound
    [ "$CLIP" = 0 ] || set -- "$@" --clipboard
    setsid "$0" "$@" </dev/null >/dev/null 2>&1 &
fi
