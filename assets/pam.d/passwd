#%PAM-1.0

auth    required                    pam_faillock.so     preauth
auth    [success=1 default=bad]     pam_unix.so         nullok
auth    [default=die]               pam_faillock.so     authfail
auth    required                    pam_faillock.so     authsucc
# pam_gnupg's setcred hook cannot start an absent agent.
auth    optional                    pam_exec.so         quiet type=auth @GPGCONF@ --launch gpg-agent
auth    optional                    @PAM_GNUPG@
auth    optional                    @PAM_GNOME_KEYRING@  auto_start
